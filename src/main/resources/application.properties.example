spring.application.name=Library-Management-System
server.port=5000

spring.datasource.url=jdbc:mysql://${MYSQL_HOST:localhost}:3306/library_db
spring.datasource.username=${MYSQL_USERNAME:root}
spring.datasource.password=${MYSQL_PASSWORD:}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
# Local: tự tạo/bổ sung các bảng còn thiếu; production nên dùng migration và đặt thành validate.
spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:update}
spring.jpa.open-in-view=false
spring.jpa.show-sql=false

# Mức phạt mỗi ngày quá hạn, tính theo đơn vị tiền chính của hệ thống.
library.fine.overdue-per-day=${OVERDUE_FINE_PER_DAY:10}

app.frontend-url=${FRONTEND_URL:http://localhost:5173}
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}

library.admin.initialize=${INITIALIZE_ADMIN:true}
library.admin.email=${ADMIN_EMAIL:admin@gmail.com}
library.admin.password=${ADMIN_PASSWORD:admin123}
library.admin.full-name=${ADMIN_FULL_NAME:Library Admin}

jwt.secret=${JWT_SECRET:replace-with-a-secret-that-is-at-least-32-bytes-long}

spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

razorpay.key.id=${RAZORPAY_KEY_ID:}
razorpay.key.secret=${RAZORPAY_KEY_SECRET:}
razorpay.callback.base-url=${RAZORPAY_CALLBACK_BASE_URL:http://localhost:5173}
